# Git Configuration
# Copy this to ~/.gitconfig and update with your personal information

[user]
  name = Your Name
  email = your.email@example.com
  # Optional: GPG signing key
  # signingkey = /path/to/your/signing/key.pub

[core]
  editor = vim
  # Optional: global gitignore file
  # excludesfile = ~/.gitignore
  pager = less -r
  mergeoptions = --no-ff
  autocrlf = false

[github]
  user = your-github-username

[color]
  branch = auto
  diff = auto
  status = auto

[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green

[color "diff"]
  commit = green
  meta = yellow
  frag = cyan
  old = red
  new = green
  whitespace = red reverse

[color "status"]
  added = yellow
  changed = green
  untracked = cyan

[color "diff-highlight"]
  oldNormal = red bold
  oldHighlight = red bold 52
  newNormal = green bold
  newHighlight = green bold 22

[alias]
  ci = commit
  st = status
  br = branch
  co = checkout
  df = diff
  lg = log --pretty=format:'%C(bold)–%Creset %C(red bold)%h%d%Creset | %C(green)%an%Creset | %C(magenta)%cr%Creset \n %C(cyan)%s%Creset'
  who = shortlog -s --
  hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short

[merge]
  ff = false

[push]
  default = current

[diff]
  tool = vimdiff

# Optional: GPG signing configuration
# [gpg]
#   format = ssh
# [commit]
#   gpgsign = true
